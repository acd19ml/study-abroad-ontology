t}.tabs button[aria-selected=false]:hover{background:var(--gray-100)}.layout{display:grid;grid-template-columns:minmax(0,1fr) 360px;gap:18px;align-items:start}.graph-panel{min-width:0;border:var(--border);border-radius:12px;background:var(--white);overflow:hidden}.toolbar{display:flex;gap:10px;padding:12px 14px;align-items:center;flex-wrap:wrap;border-bottom:var(--border)}.toolbar label{color:var(--gray-700);font-size:12px}.toolbar select{max-width:310px;min-width:160px;height:36px;border:var(--border);background:var(--white);border-radius:8px;padding:0 8px}.search{position:relative;flex:1 1 220px}.search input{width:100%;height:36px;padding:0 10px;border:var(--border);border-radius:8px;background:var(--ivory)}.results{position:absolute;left:0;top:42px;width:min(500px,85vw);z-index:20;background:var(--white);border:var(--border);border-radius:10px;padding:6px;box-shadow:var(--shadow-md);max-height:380px;overflow:auto}.results[hidden]{display:none}.results button{display:block;width:100%;text-align:left;border:0;border-radius:6px;font-size:13px;font-weight:430}.results small{display:block;font-size:11px;color:var(--gray-700);font-family:var(--mono)}.search-feedback{font-size:12px;padding:8px;color:var(--gray-700)}.tools{display:flex;gap:5px;align-items:center}.tools button{padding:5px 10px;min-width:36px}.view-intro{display:flex;justify-content:space-between;gap:16px;padding:12px 16px;background:var(--ivory);font-size:12px;color:var(--gray-700)}.view-intro span:first-child{max-width:760px}.canvas{height:690px;min-height:420px;position:relative;touch-action:none;overflow:hidden;background:var(--ivory)}svg{width:100%;height:100%;display:block;user-select:none}.graph-note{position:absolute;bottom:12px;left:14px;padding:3px 8px;background:var(--ivory);font-size:10px;color:var(--gray-700);pointer-events:none}.edge .line{fill:none;stroke:var(--gray-300);stroke-width:1.6;marker-end:url(#arrow)}.edge.active .line,.edge.selected .line{stroke:var(--clay-d);stroke-width:2.3;marker-end:url(#arrow-active)}.edge.muted{opacity:.3}.edge .hit{fill:none;stroke:transparent;stroke-width:18;cursor:pointer}.edge text{font:12.5px var(--sans);fill:var(--gray-700);pointer-events:none}.edge.active text,.edge.selected text{fill:var(--rust)}.edge .edge-label-bg{fill:var(--ivory);opacity:.96;pointer-events:none}.node{cursor:pointer}.node rect{fill:var(--white);stroke:var(--gray-300);stroke-width:1.5;rx:10}.node:hover rect,.node:focus rect{stroke:var(--clay)}.node.selected rect{stroke:var(--clay-d);stroke-width:2.5;fill:var(--oat)}.node.muted{opacity:.4}.node text{pointer-events:none;fill:var(--slate)}.node .node-caption{font:13.5px var(--mono);fill:var(--gray-700)}.node .node-name{font:500 17px var(--sans)}.node.derived rect{stroke-dasharray:5 3}.group-label{font:13px var(--sans);fill:var(--gray-700)}.group-line{stroke:var(--gray-300);stroke-width:1;stroke-dasharray:4 5}.inspector{background:var(--white);border:var(--border);border-radius:12px;position:sticky;top:16px;max-height:calc(100vh - 32px);overflow:auto;padding:20px;min-width:0}.inspector h2{font-size:23px;line-height:1.4;overflow-wrap:anywhere;margin:9px 0 8px}.inspector .element-id{font:11px/1.6 var(--mono);overflow-wrap:anywhere;color:var(--gray-700);margin-bottom:14px}.detail-section{border-top:var(--border);padding-top:14px;margin-top:16px}.detail-section h3{font:500 12px var(--mono);letter-spacing:.03em;margin-bottom:9px;color:var(--gray-700)}.prop{display:grid;grid-template-columns:86px minmax(0,1fr);gap:9px;padding:5px 0;font-size:12px}.prop-label{color:var(--gray-700)}.prop-value{overflow-wrap:anywhere;min-width:0}.ref{border:0;min-height:0;padding:2px 0;text-align:left;display:inline;color:var(--rust);font-size:12px;background:transparent;font-weight:450}.ref:hover{background:transparent;text-decoration:underline}.prop-value code,.source-link,pre{font-family:var(--mono);font-size:11px}.attr{padding:10px 0;border-bottom:1px solid var(--gray-100)}.attr:last-child{border:0}.attr strong{font: