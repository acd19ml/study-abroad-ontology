let drag=null;svg.addEventListener('pointerdown',ev=>{if(ev.target.closest('.node,.edge')||ev.button!==0)return;drag={x:ev.clientX,y:ev.clientY,camera:{...state.camera}};svg.setPointerCapture(ev.pointerId);});svg.addEventListener('pointermove',ev=>{if(!drag)return;state.camera={...drag.camera,x:drag.camera.x-(ev.clientX-drag.x)*drag.camera.w/canvas.clientWidth,y:drag.camera.y-(ev.clientY-drag.y)*drag.camera.h/canvas.clientHeight};updateCamera();});svg.addEventListener('pointerup',()=>{drag=null;});svg.addEventListener('pointercancel',()=>{drag=null;});svg.addEventListener('wheel',ev=>{if(ev.ctrlKey||ev.metaKey){ev.preventDefault();zoom(ev.deltaY>0?1.12:.89);}},{passive:false});svg.addEventListener('keydown',ev=>{if(ev.target!==svg)return;const moves={ArrowLeft:[-1,0],ArrowRight:[1,0],ArrowUp:[0,-1],ArrowDown:[0,1]};if(moves[ev.key]){ev.preventDefault();state.camera.x+=moves[ev.key][0]*state.camera.w*.1;state.camera.y+=moves[ev.key][1]*state.camera.h*.1;updateCamera();}});
let lastWidth=0;new ResizeObserver(entries=>{const width=entries[0].contentRect.width;if(Math.abs(width-lastWidth)>10){lastWidth=width;resetCamera();}}).observe(canvas);
document.getElementById('stamp').replaceChildren();document.getElementById('stamp').append(el('div','',D.meta.version),el('div','','源指纹 '+D.meta.source_hash.slice(0,12)),el('div','','展示指纹 '+D.meta.generator_hash.slice(0,12)));
document.getElementById('counts').replaceChildren();const counts=[['模型元素',D.elements.length],['业务对象',D.elements.filter(e=>e.type==='object').length],['显式关系',D.elements.filter(e=>e.type==='relation').length],['业务规则',D.elements.filter(e=>e.type==='rule').length]];for(const [name,value] of counts){const c=el('span');c.append(el('strong','',value),el('small','',name));document.getElementById('counts').append(c);}
for(const item of D.meta.pending)document.getElementById('pending').append(el('li','',item));document.getElementById('provenance').textContent=JSON.stringify(D.meta,null,2);
document.getElementById('footer').textContent='模型版本 '+D.meta.version+' · 源指纹 '+D.meta.source_hash+' · 本页由 tools/generator/render_model.py 生成，业务变更请先修改 model/。';
