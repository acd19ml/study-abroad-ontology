nd:var(--clay);border-color:var(--clay)}.check input:checked:after{content:'✓';display:block;color:var(--white);font:12px/12px var(--sans);text-align:center}.view-option[hidden]{display:none}
@media(min-width:1550px){.canvas{height:760px}.layout{grid-template-columns:minmax(0,1fr) 390px}.page{padding-left:40px;padding-right:40px}}@media(max-width:1050px){.layout{grid-template-columns:minmax(0,1fr) 310px}.inspector{padding:16px}.toolbar select{max-width:210px}.canvas{height:650px}}@media(max-width:880px){.page{padding:26px 18px 60px}.layout{grid-template-columns:minmax(0,1fr)}.inspector{position:static;max-height:none}.canvas{height:590px}.stamp{font-size:10px}.inspector .detail-section{max-width:none}}@media(max-width:640px){.page{padding:22px 12px 50px}h1{font-size:27px}.header-row{display:block}.stamp{text-align:left;margin-top:10px}.counts{gap:12px}.counts strong{font-size:15px}.intro{font-size:12px}.toolbar{padding:10px}.search{flex-basis:100%}.view-intro{display:block;padding:10px;font-size:11px}.canvas{height:520px}.tabs{gap:2px}.tabs button{padding:6px 9px;font-size:12px}.toolbar select{max-width:240px}.graph-note{font-size:9px}.prop{grid-template-columns:82px minmax(0,1fr)}}
